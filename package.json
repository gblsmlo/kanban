{
  "name": "@tc96/collection-views",
  "version": "0.4.0",
  "description": "Domain-neutral collection views for React applications using COSS primitives and DnD Kit.",
  "type": "module",
  "license": "MIT",
  "author": "Gabriel Melo",
  "keywords": [
    "base-ui",
    "coss",
    "dnd-kit",
    "collection",
    "collection-views",
    "kanban",
    "list",
    "react",
    "saas"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gblsmlo/kanban.git"
  },
  "homepage": "https://github.com/gblsmlo/kanban#readme",
  "bugs": {
    "url": "https://github.com/gblsmlo/kanban/issues"
  },
  "packageManager": "bun@1.3.14",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "files": [
    "dist",
    "registry",
    "registry.json",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js"
    },
    "./registry": "./registry/collection-views.json",
    "./registry/collection-views.json": "./registry/collection-views.json",
    "./registry/kanban.json": "./registry/collection-views.json"
  },
  "scripts": {
    "build": "bun run clean && bun build ./src/index.ts ./src/core.ts --outdir ./dist --target browser --format esm --packages external && tsc -p tsconfig.build.json",
    "clean": "rm -rf dist storybook-static",
    "lint": "biome check --write .",
    "lint:ci": "biome ci .",
    "prepare": "bun run build",
    "prepublishOnly": "bun run build",
    "pack:check": "npm pack --dry-run",
    "storybook": "storybook dev -p 6007 --no-open",
    "storybook:build": "storybook build",
    "test": "bun test",
    "test:types": "tsc -p tsconfig.type-tests.json",
    "test:storybook": "vitest run --project storybook",
    "toolchain:check": "sh scripts/check-toolchain.sh",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@dnd-kit/abstract": "0.5.0",
    "@dnd-kit/collision": "0.5.0",
    "@dnd-kit/dom": "0.5.0",
    "@dnd-kit/helpers": "0.5.0",
    "@dnd-kit/react": "0.5.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "tailwind-merge": "3.6.0"
  },
  "peerDependencies": {
    "@base-ui/react": ">=1.6.0 <2",
    "lucide-react": ">=1.28.0 <2",
    "react": ">=19.1.1 <20",
    "react-dom": ">=19.1.1 <20",
    "tailwindcss": ">=4.2.2 <5"
  },
  "devDependencies": {
    "@base-ui/react": "1.6.0",
    "@biomejs/biome": "2.3.4",
    "@storybook/addon-a11y": "10.5.0",
    "@storybook/addon-docs": "10.5.0",
    "@storybook/addon-vitest": "10.5.0",
    "@storybook/react-vite": "10.5.0",
    "@tailwindcss/vite": "4.2.2",
    "@tc96/biome-config": "2.3.0",
    "@testing-library/react": "^16.3.0",
    "@types/bun": "^1.3.14",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.11",
    "@types/react-dom": "^19.1.7",
    "@vitest/browser": "^4.1.10",
    "@vitest/browser-playwright": "^4.1.10",
    "jsdom": "^26.1.0",
    "lucide-react": "1.28.0",
    "playwright": "^1.61.1",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "storybook": "10.5.0",
    "tailwindcss": "4.2.2",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "vite": "^7.1.0",
    "vitest": "^4.1.10"
  }
}
